
<div class="log">
<p>
<h1>Title:</h1>
  <%= @article.title %>
</p>
 
<p>
<h2>Text:</h2>
  <%= @article.text %>
</p>
<div class="card"  style="width: 18rem;">
  <div class="card-body">
<h3>Comments:</h3>
<% if  !@article.comments.empty? %>
<%= render @article.comments %>
<% else %>
<p> There are no comments for this article </p>

<% end %>
 </div>
</div>

<div class="card mt-4 mb-4"  style="width: 18rem;">
  <div class="card-body">
<h5>Add a comment:</h5>
<%= render 'comments/form' %>
 </div>
</div>
<ul>
  <li><%= link_to "Edit", edit_article_path(@article) %></li>
  <li><%= link_to "Delete", article_path(@article), data: {
    turbo_method: :delete,
    turbo_confirm: "Are you sure?"
  } %></li>
</ul>

<%= link_to 'Back', articles_path %>
</div>