<% if user_signed_in? %>
<div class="click">
<h5 >Click a word to find an article</h5>
</div>

<% end %>
<div class="welcome_articles">

<h1>Published Articles</h1>
<% if user_signed_in? %>




<hr>

  <% @articles.each do |article| %>

    <div class="card" style="width: 18rem;">
  <div class="card-body">
    <h5 class="card-title"><%= article.title %></h5>
    <h6 class="card-subtitle mb-2 text-body-secondary">Published: <%= article.created_at.strftime("%m/%d/%Y") %></h6>
    <p class="card-text">By: <%= article.user&.name %></p>
   
     <%= link_to article.title,  article_path(article.id), class: 'card-link' %>
  </div>
</div>

  
    <br>
  <% end %>


<% else %>
<h5>(Login to read)</h5>
<hr>
<ul>
  <% @articles.each do |article| %>
    <li>
   <%= article.title %> by <%= article.user&.name %>
    </li>

    <br>
  <% end %>
</ul>

<% end %>
</div>

